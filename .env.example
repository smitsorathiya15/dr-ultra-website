# ============================================================
# Dr. Ultra Frontend — Environment Configuration
# Copy this file to ".env" and adjust for your environment.
# Vite only exposes variables prefixed with VITE_ to the browser —
# never put real secrets here, this file ships to the browser bundle.
# ============================================================

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# Public site info used across the site (footer, SEO tags, etc.)
VITE_SITE_URL=https://www.drultra.co.in
VITE_SITE_NAME="Dr. Ultra"

# Google Maps embed URL for the Contact page.
# Generate one for free at https://www.google.com/maps -> Share -> Embed a map
# (no API key required for the basic iframe embed).
VITE_GOOGLE_MAPS_EMBED_SRC=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3719.591!2d72.5713!3d23.0225!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDAxJzIxLjAiTiA3MsKwMzQnMTYuNyJF!5e0!3m2!1sen!2sin!4v0000000000000
